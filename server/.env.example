# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/coding_arena
# OR use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/coding_arena

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456

# Judge0 API (Code Execution)
# Option 1: Use RapidAPI hosted Judge0
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Option 2: Self-hosted Judge0
# JUDGE0_API_URL=http://localhost:2358

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
